  userId            String                         @map("user_id") @db.Uuid
  linkTokenHash     String                         @unique(map: "email_verification_challenges_link_token_hash_key") @map("link_token_hash") @db.VarChar(128)
  credentialVersion BigInt?                        @map("credential_version") @db.BigInt
  otpMac            String?                        @map("otp_mac") @db.VarChar(64)
