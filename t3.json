{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "[ -f .env ] || cp \"$(git rev-parse --git-common-dir)/../.env\" .env; pnpm install --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Verify",
      "command": "export TEST_DATABASE_URL=\"$(grep '^TEST_DATABASE_URL=' .env | cut -d= -f2-)\" && pnpm verify",
      "icon": "build",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Dev API",
      "command": "pnpm dev:api",
      "icon": "debug",
      "runOnWorktreeCreate": false
    },
    {
      "name": "Dev Web",
      "command": "pnpm dev:web",
      "icon": "debug",
      "runOnWorktreeCreate": false
    }
  ]
}
