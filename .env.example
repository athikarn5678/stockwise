# StockWise environment contract
#
# The repository foundation defines ownership and handling rules. Copy this file
# to .env for the local web-to-API development path.

# Ownership and exposure
# - apps/web owns browser/build-time configuration. STOCKWISE_API_ORIGIN is read
#   only by next.config.ts from this root .env file to configure the local
#   development proxy; it is not a NEXT_PUBLIC_ value and never enters the client
#   bundle.
# - apps/api owns server-only runtime configuration. STOCKWISE_API_PORT controls
#   the loopback listener. Server-only values must never be exposed to the web
#   process or a client bundle.
# - compose.yaml owns the local Docker PostgreSQL configuration below. These
#   variables are development-only Docker inputs, not browser configuration or
#   application credentials. apps/api owns DATABASE_URL for Prisma and runtime
#   database access; it must match the Docker inputs and is never web config.
# - Each process validates only its own environment with Zod at startup.

# Required at this stage
# - Web development server: http://localhost:3000 (fixed command port).
# - API loopback listener: http://127.0.0.1:3001.
STOCKWISE_API_PORT=3001
STOCKWISE_API_ORIGIN=http://127.0.0.1:3001

# API authentication/session configuration (P2-M2-T02)
# development keeps the stockwise_session cookie usable over the accepted local
# HTTP loopback path. Production makes that cookie Secure.
STOCKWISE_RUNTIME_ENV=development
STOCKWISE_SESSION_IDLE_TIMEOUT_MINUTES=1440
STOCKWISE_SESSION_ABSOLUTE_TIMEOUT_MINUTES=10080
STOCKWISE_SESSION_TOUCH_INTERVAL_MINUTES=15

# API identity email configuration (P2-M2-T03)
# Development defaults to non_delivery; set resend for local manual UAT while
# keeping STOCKWISE_RUNTIME_ENV=development and local HTTP session behavior.
# Test is always non_delivery and rejects resend. Production defaults to resend
# and rejects non_delivery. Resend requires both credentials in either runtime.
# All values are server-only; none may enter browser bundles.
STOCKWISE_PUBLIC_WEB_ORIGIN=http://localhost:3000
STOCKWISE_EMAIL_PROVIDER=non_delivery
STOCKWISE_EMAIL_FROM=StockWise <no-reply@example.com>
RESEND_API_KEY=<replace-with-resend-api-key>

# Scheduled AI provider (P7-M2-T01). Server-only and optional for ordinary API
# startup; an AI generation attempt without a real key fails safely before I/O.
# The requested model is openrouter/free with no paid fallback; OpenRouter
# selects the underlying free model. Timeout and budgets remain fixed by ADR-033.
OPENROUTER_API_KEY=<replace-with-openrouter-api-key>

# API analytics cursor signing (P6-M2-T03). Required in every runtime mode.
# Set to canonical base64url for at least 32 cryptographically random bytes.
# Use the same secret across restarts and API instances; never expose it to web.
STOCKWISE_ANALYTICS_CURSOR_HMAC_KEY=<replace-with-persistent-base64url-secret>

# API verification key material (T02A). Server-only and required in every
# runtime mode. Each value is canonical unpadded base64url of a dedicated
# secret: the OTP key is at least 32 bytes and the current proof key is
# exactly 32 bytes. The OTP and proof keys must be distinct from each other
# and from STOCKWISE_ANALYTICS_CURSOR_HMAC_KEY and any provider API key.
# Key IDs are stable integers: the OTP key ID fits a signed 32-bit integer
# and the proof key IDs are unsigned 32-bit integers. Set the previous proof
# key, its ID, and its last-issued-at timestamp only while rotating; the
# previous key must be distinct from the current proof and OTP keys and is
# retained for at least 605 seconds after its last issuance.
STOCKWISE_VERIFICATION_OTP_KEY=<replace-with-dedicated-base64url-secret>
STOCKWISE_VERIFICATION_OTP_KEY_ID=1
STOCKWISE_VERIFICATION_PROOF_KEY=<replace-with-dedicated-base64url-secret>
STOCKWISE_VERIFICATION_PROOF_KEY_ID=2
# Optional previous-key rotation metadata: supply all three together.
# STOCKWISE_VERIFICATION_PREVIOUS_PROOF_KEY=<previous-dedicated-base64url-key>
# STOCKWISE_VERIFICATION_PREVIOUS_PROOF_KEY_ID=<previous-unsigned-integer-key-id>
# STOCKWISE_VERIFICATION_PREVIOUS_PROOF_KEY_LAST_ISSUED_AT=<ISO-8601-timestamp-with-timezone>

# API authentication authority (D5-P5): exactly one per process, `legacy` or
# `native`. Unset means `legacy` for development/test and `native` for
# production; production rejects `legacy`. Native starts only against a database
# sealed NATIVE by `pnpm --filter @stockwise/api native:cutover`; Legacy refuses
# any database whose transition fence has left LEGACY. There is no fallback.
# STOCKWISE_AUTHENTICATION_AUTHORITY=legacy

# Native-only session signing key. Provision at least 32 random bytes as
# canonical unpadded base64url, stable across restarts/instances and distinct
# from all other API keys. Ignored by Legacy; required and validated before
# Native construction.
# STOCKWISE_BETTER_AUTH_SECRET=<dedicated-persistent-native-base64url-secret>

# API invitation continuation encryption (Product-INVITE-UX-01). Required by
# Legacy and Native auth runtime construction; exactly 32 random bytes encoded
# as canonical unpadded base64url, dedicated and distinct from every other key.
# Keep stable for at least the 30-minute continuation lifetime; rotation
# invalidates outstanding continuations. Never expose this API-only key to web.
STOCKWISE_INVITATION_CONTINUATION_KEY=<replace-with-dedicated-32-byte-base64url-key>

# Local Docker PostgreSQL development configuration (P1-M3-T01)
# Replace every angle-bracket placeholder with a unique, non-production local
# value before starting Docker. Do not reuse production credentials here.
STOCKWISE_POSTGRES_USER=<replace-with-local-postgres-user>
STOCKWISE_POSTGRES_PASSWORD=<replace-with-local-postgres-password>
STOCKWISE_POSTGRES_DATABASE=<replace-with-local-postgres-database>
STOCKWISE_POSTGRES_PORT=5432

# API PostgreSQL connection configuration (P1-M3-T02)
# Replace every placeholder with the same local, non-production Docker value
# above. Percent-encode reserved URL characters in the username, password, or
# database name. Do not expose this server-only URL through NEXT_PUBLIC_ values.
DATABASE_URL=postgresql://<local-user>:<local-password>@127.0.0.1:5432/<local-database>?schema=public

# Database test harness configuration (P1-M3-T03)
# apps/api test code owns this server-only URL. Supply it explicitly in the
# test process environment for pnpm test, pnpm test:db, or pnpm test:e2e;
# destructive test setup never loads it from .env. It must differ from
# DATABASE_URL and is never web config.
# The harness accepts only a loopback PostgreSQL URL whose database name ends in
# _test. The configured role must be able to create that disposable database
# through its local postgres database. Never use a shared or production target.
# The stale stockwise_test name is denied unless explicitly opted into as CI does.
TEST_DATABASE_URL=postgresql://<local-user>:<local-password>@127.0.0.1:5432/<local-test-database>_test?schema=public

# Future cloud configuration blocked by open decisions or later implementation
# - AWS topology, region, secret mechanism, and production targets: OQ-015 and
#   OQ-020 during cloud delivery.

# Secret handling
# - Never commit populated .env files, real credentials, tokens, or production
#   values. The repository ignore policy excludes .env and .env.* while allowing
#   only example files.
# - Keep secrets out of source, logs, errors, screenshots, analytics snapshots,
#   AI prompts, test fixtures, generated artifacts, and client bundles.
# - Use placeholders only after a variable name and owner are accepted; examples
#   must never be usable credentials.
