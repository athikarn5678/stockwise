generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE

  @@map("organization_status")
}

enum OrganizationRole {
  OWNER
  ADMIN
  BRANCH_MANAGER
  INVENTORY_STAFF
  CASHIER

  @@map("organization_role")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

enum BranchAssignmentStatus {
  ACTIVE
  INACTIVE

  @@map("branch_assignment_status")
}

enum CatalogStatus {
  ACTIVE
  INACTIVE

  @@map("catalog_status")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE

  @@map("supplier_status")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum InventoryCostBasisState {
  UNKNOWN
  KNOWN

  @@map("inventory_cost_basis_state")
}

enum SalesVatStatus {
  UNCONFIGURED
  NOT_REGISTERED
  REGISTERED

  @@map("sales_vat_status")
}

enum SaleDiscountType {
  AMOUNT
  PERCENT

  @@map("sale_discount_type")
}

enum SaleIdempotencyOperation {
  SALE_CHECKOUT

  @@map("sale_idempotency_operation")
}

enum SaleRefundIdempotencyOperation {
  SALE_REFUND

  @@map("sale_refund_idempotency_operation")
}

enum PaymentMethod {
  CASH
  TRANSFER

  @@map("payment_method")
}

enum ProductUnit {
  EA
  PACK
  BOX
  KG
  G
  L
  ML
  M
  CM

  @@map("product_unit")
}

enum InvitationRevocationReason {
  REPLACED
  CANCELLED
  DELIVERY_FAILED
  MEMBERSHIP_EXISTS

  @@map("invitation_revocation_reason")
}

enum MembershipAccessEventType {
  INVITATION_ACCEPTED
  ROLE_SCOPE_REPLACED
  DEACTIVATED
  REACTIVATED

  @@map("membership_access_event_type")
}

enum AnalyticsSnapshotScope {
  ORGANIZATION
  BRANCH

  @@map("analytics_snapshot_scope")
}

enum AnalyticsSnapshotCadence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@map("analytics_snapshot_cadence")
}

enum AiInsightState {
  IN_PROGRESS
  SUCCEEDED
  FAILED
  INSUFFICIENT

  @@map("ai_insight_state")
}

enum AiInsightFailureCategory {
  TIMEOUT
  TRANSPORT
  RATE_LIMITED
  PROVIDER_UNAVAILABLE
  AUTHENTICATION
  INVALID_REQUEST
  INVALID_RESPONSE
  PROVIDER_ERROR
  INTERRUPTED

  @@map("ai_insight_failure_category")
}

enum VerificationConsumptionMethod {
  OTP
  LINK

  @@map("verification_consumption_method")
}

enum VerificationRevocationReason {
  LEGACY_CUTOVER
  NATIVE_CUTOVER
  DELIVERY_SUPPRESSED
  DELIVERY_FAILED
  RESPONSE_ABORTED
  PASSWORD_RESET

  @@map("verification_revocation_reason")
}

model User {
  id                            String     @id @default(uuid()) @db.Uuid
  email                         String     @unique(map: "users_email_key") @db.VarChar(320)
  // Public dummy verifier; its random preimage was discarded, never a credential.
  passwordHash                  String     @default("$argon2id$v=19$m=65536,p=4,t=3$MELWslgkJzw87Me69Wz1tw$l9XoBv1UBhpmS40M2xzT5cHzqoSubftPd1Md5u/ZmvQ") @map("password_hash") @db.VarChar(255)
  status                        UserStatus @default(ACTIVE)
  displayName                   String?    @map("display_name") @db.VarChar(200)
  phone                         String?    @db.VarChar(32)
  emailVerifiedAt               DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  emailVerified                 Boolean    @default(false) @map("better_auth_email_verified")
  image                         String?    @map("better_auth_image")
  nativeRegistrationCompletedAt DateTime?  @map("native_registration_completed_at") @db.Timestamptz(3)
  passwordChangedAt             DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  credentialVersion             BigInt     @default(1) @map("credential_version") @db.BigInt
  nativeAuthEnrollment          NativeAuthEnrollment?
  disabledAt                    DateTime?  @map("disabled_at") @db.Timestamptz(3)
  createdAt                     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships                 OrganizationMembership[]
  sessions                    Session[]
  betterAuthSessions          BetterAuthSession[]
  betterAuthAccounts          BetterAuthAccount[]
  pendingRegistrations        PendingRegistration[]
  emailVerificationChallenges EmailVerificationChallenge[]
  passwordResetTokens         PasswordResetToken[]
  acceptedInvitations         Invitation[]
  membershipAccessEvents      MembershipAccessEvent[]
  inventoryTransactions       InventoryTransaction[]
  receivedPurchaseReceipts    PurchaseReceipt[]            @relation("PurchaseReceiptReceiverUser")
  completedSales              Sale[]                       @relation("SaleActorUser")
  completedSaleRefunds        SaleRefund[]                 @relation("SaleRefundActorUser")

  @@unique([id, email], map: "users_id_email_key")
  @@map("users")
}

// D3 staging only: never a credential or an authenticated identity.
model PendingRegistration {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique(map: "pending_registrations_email_key") @db.VarChar(320)
  credentialVersion BigInt    @default(1) @map("credential_version")
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  issuedAt          DateTime  @map("issued_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  challengeId       String?   @unique(map: "pending_registrations_challenge_id_key") @map("challenge_id") @db.Uuid
  otpMac            String?   @map("otp_mac") @db.Char(64)
  otpKeyId          Int?      @map("otp_key_id")
  linkTokenHash     String?   @unique(map: "pending_registrations_link_token_hash_key") @map("link_token_hash") @db.Char(64)
  failedOtpAttempts Int       @default(0) @map("failed_otp_attempts")
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  userId            String?   @map("user_id") @db.Uuid
  user              User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "pending_registrations_user_id_fkey")

  @@index([expiresAt], map: "pending_registrations_expires_at_idx")
  @@map("pending_registrations")
}

// Durable D3 quotas survive process replacement; key is a canonical-email digest.
model PendingRegistrationQuota {
  key                String                                 @db.Char(64)
  purpose            String                                 @db.VarChar(16)
  windowAt           DateTime                               @map("window_at") @db.Timestamptz(3)
  count              Int                                    @default(0)
  credentialAttempts PendingRegistrationCredentialAttempt[]

  @@id([key, purpose], map: "pending_registration_quotas_pkey")
  @@index([windowAt], map: "pending_registration_quotas_window_at_idx")
  @@map("pending_registration_quotas")
}

// A quota slot is occupied before Argon2; unknown outcomes remain charged until
// the fixed window ends. Lease expiry invalidates proof, not comparison history.
model PendingRegistrationCredentialAttempt {
  id        String                   @id @default(uuid()) @db.Uuid
  key       String                   @db.Char(64)
  purpose   String                   @default("credential") @db.VarChar(16)
  windowAt  DateTime                 @map("window_at") @db.Timestamptz(3)
  expiresAt DateTime                 @map("expires_at") @db.Timestamptz(3)
  quota     PendingRegistrationQuota @relation(fields: [key, purpose], references: [key, purpose], onDelete: Cascade, onUpdate: Restrict, map: "pending_registration_credential_attempts_quota_fkey")

  @@index([key, purpose], map: "pending_registration_credential_attempts_key_idx")
  @@index([expiresAt], map: "pending_registration_credential_attempts_expires_at_idx")
  @@map("pending_registration_credential_attempts")
}

model BetterAuthSession {
  id                         String   @id @default(uuid()) @db.Uuid
  token                      String   @unique(map: "better_auth_sessions_token_key")
  userId                     String   @map("user_id") @db.Uuid
  stockwisePurpose           String?  @map("stockwise_purpose") @db.VarChar(16)
  stockwiseCredentialVersion BigInt?  @map("stockwise_credential_version") @db.BigInt
  expiresAt                  DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress                  String?  @map("ip_address")
  userAgent                  String?  @map("user_agent")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "better_auth_sessions_user_id_fkey")

  @@index([userId], map: "better_auth_sessions_user_id_idx")
  @@map("better_auth_sessions")
}

model BetterAuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "better_auth_accounts_user_id_fkey")

  nativeAuthEnrollment NativeAuthEnrollment?
  @@unique([providerId, accountId], map: "better_auth_accounts_provider_id_account_id_key")
  @@index([userId], map: "better_auth_accounts_user_id_idx")
  @@map("better_auth_accounts")
}

model BetterAuthVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier], map: "better_auth_verifications_identifier_idx")
  @@map("better_auth_verifications")
}

model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(200)
  status            OrganizationStatus @default(ACTIVE)
  salesVatStatus    SalesVatStatus     @default(UNCONFIGURED) @map("sales_vat_status")
  salesVatRate      Decimal?           @map("sales_vat_rate") @db.Decimal(9, 6)
  reportingTimezone String             @default("Asia/Bangkok") @map("reporting_timezone") @db.VarChar(255)
  deactivatedAt     DateTime?          @map("deactivated_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships           OrganizationMembership[]
  branches              Branch[]
  invitations           Invitation[]
  categories            Category[]
  products              Product[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  purchaseReceipts      PurchaseReceipt[]
  sales                 Sale[]
  saleRefunds           SaleRefund[]
  inventoryBalances     InventoryBalance[]
  inventoryCostStates   InventoryCostState[]
  inventoryTransactions InventoryTransaction[]
  branchStatusEvents    BranchStatusEvent[]
  analyticsSnapshots    AnalyticsSnapshot[]
  aiInsightReports      AiInsightReport[]
  demoDatasetRun        DemoDatasetRun?

  @@map("organizations")
}

model Supplier {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(160)
  contactName    String?        @map("contact_name") @db.VarChar(120)
  email          String?        @db.VarChar(254)
  phone          String?        @db.VarChar(40)
  address        String?        @db.VarChar(500)
  status         SupplierStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]

  @@unique([id, organizationId], map: "suppliers_id_organization_id_key")
  @@index([organizationId, status, createdAt, id], map: "suppliers_organization_id_status_created_at_id_idx")
  @@map("suppliers")
}

model Category {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.Text
  normalizedName String        @map("normalized_name") @db.Text
  description    String?       @db.Text
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products     Product[]

  @@unique([organizationId, normalizedName], map: "categories_organization_id_normalized_name_key")
  @@unique([id, organizationId], map: "categories_id_organization_id_key")
  @@index([organizationId, status, name], map: "categories_organization_id_status_name_idx")
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  name           String        @db.Text
  description    String?       @db.Text
  sku            String        @db.VarChar(64)
  barcode        String?       @db.VarChar(128)
  basePrice      Decimal       @map("base_price") @db.Decimal(19, 4)
  unit           ProductUnit
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category              Category?              @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  inventoryCostStates   InventoryCostState[]
  purchaseOrderItems    PurchaseOrderItem[]
  purchaseReceiptItems  PurchaseReceiptItem[]
  saleItems             SaleItem[]
  saleRefundItems       SaleRefundItem[]

  @@unique([organizationId, sku], map: "products_organization_id_sku_key")
  @@unique([organizationId, barcode], map: "products_organization_id_barcode_key")
  @@unique([id, organizationId], map: "products_id_organization_id_key")
  @@index([organizationId, status, name], map: "products_organization_id_status_name_idx")
  @@index([categoryId, organizationId], map: "products_category_id_organization_id_idx")
  @@map("products")
}

model PurchaseOrder {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  branchId              String              @map("branch_id") @db.Uuid
  supplierId            String              @map("supplier_id") @db.Uuid
  reference             String              @db.Text
  status                PurchaseOrderStatus @default(DRAFT)
  orderDate             DateTime            @map("order_date") @db.Date
  expectedDate          DateTime?           @map("expected_date") @db.Date
  currency              String              @default("THB") @db.Char(3)
  expectedTotal         Decimal             @map("expected_total") @db.Decimal(19, 4)
  createdByUserId       String              @map("created_by_user_id") @db.Uuid
  createdByMembershipId String              @map("created_by_membership_id") @db.Uuid
  orderedAt             DateTime?           @map("ordered_at") @db.Timestamptz(3)
  cancelledAt           DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  receivedAt            DateTime?           @map("received_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch              Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  supplier            Supplier               @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdByMembership OrganizationMembership @relation("PurchaseOrderCreator", fields: [organizationId, createdByMembershipId, createdByUserId], references: [organizationId, id, userId], onDelete: Restrict, onUpdate: Restrict)
  items               PurchaseOrderItem[]
  receipt             PurchaseReceipt?

  @@unique([id, organizationId], map: "purchase_orders_id_organization_id_key")
  @@unique([id, organizationId, branchId, supplierId], map: "purchase_orders_receipt_scope_key")
  @@unique([organizationId, reference], map: "purchase_orders_organization_id_reference_key")
  @@index([organizationId, branchId, status, orderDate], map: "purchase_orders_organization_branch_status_order_date_idx")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  purchaseOrderId     String   @map("purchase_order_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productSkuSnapshot  String   @map("product_sku_snapshot") @db.VarChar(64)
  productNameSnapshot String   @map("product_name_snapshot") @db.Text
  quantity            Decimal  @db.Decimal(18, 4)
  expectedUnitCost    Decimal  @map("expected_unit_cost") @db.Decimal(19, 4)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  product       Product              @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  receiptItem   PurchaseReceiptItem?

  @@unique([purchaseOrderId, productId], map: "purchase_order_items_purchase_order_id_product_id_key")
  @@unique([id, organizationId, purchaseOrderId, productId], map: "purchase_order_items_receipt_scope_key")
  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id                                String    @id @default(uuid()) @db.Uuid
  organizationId                    String    @map("organization_id") @db.Uuid
  branchId                          String    @map("branch_id") @db.Uuid
  supplierId                        String    @map("supplier_id") @db.Uuid
  purchaseOrderId                   String    @map("purchase_order_id") @db.Uuid
  reference                         String    @db.Text
  receivedAt                        DateTime  @map("received_at") @db.Timestamptz(3)
  receivedByUserId                  String    @map("received_by_user_id") @db.Uuid
  receivedByMembershipId            String    @map("received_by_membership_id") @db.Uuid
  idempotencyKeyHash                String    @map("idempotency_key_hash") @db.VarChar(64)
  canonicalRequestHash              String    @map("canonical_request_hash") @db.VarChar(64)
  organizationVatRegisteredSnapshot Boolean   @map("organization_vat_registered_snapshot")
  inputVatRate                      Decimal?  @map("input_vat_rate") @db.Decimal(9, 6)
  inputVatAmount                    Decimal?  @map("input_vat_amount") @db.Decimal(19, 4)
  supplierTaxDocumentNumber         String?   @map("supplier_tax_document_number") @db.VarChar(100)
  supplierTaxDocumentDate           DateTime? @map("supplier_tax_document_date") @db.Date
  createdAt                         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch               Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  supplier             Supplier               @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  purchaseOrder        PurchaseOrder          @relation(fields: [purchaseOrderId, organizationId, branchId, supplierId], references: [id, organizationId, branchId, supplierId], onDelete: Restrict, onUpdate: Restrict)
  receivedByUser       User                   @relation("PurchaseReceiptReceiverUser", fields: [receivedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receivedByMembership OrganizationMembership @relation("PurchaseReceiptReceiverMembership", fields: [organizationId, receivedByMembershipId, receivedByUserId], references: [organizationId, id, userId], onDelete: Restrict, onUpdate: Restrict)
  items                PurchaseReceiptItem[]

  @@unique([id, organizationId], map: "purchase_receipts_id_organization_id_key")
  @@unique([id, organizationId, purchaseOrderId, branchId], map: "purchase_receipts_item_scope_key")
  @@unique([purchaseOrderId, organizationId], map: "purchase_receipts_purchase_order_id_organization_id_key")
  @@unique([purchaseOrderId, organizationId, branchId, supplierId], map: "purchase_receipts_purchase_order_scope_key")
  @@unique([organizationId, reference], map: "purchase_receipts_organization_id_reference_key")
  @@unique([organizationId, idempotencyKeyHash], map: "purchase_receipts_organization_id_idempotency_key_hash_key")
  @@index([organizationId, branchId, receivedAt, id], map: "purchase_receipts_organization_branch_received_at_id_idx")
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  String   @id @default(uuid()) @db.Uuid
  receiptId           String   @map("receipt_id") @db.Uuid
  purchaseOrderId     String   @map("purchase_order_id") @db.Uuid
  purchaseOrderItemId String   @map("purchase_order_item_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  branchId            String   @map("branch_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productSkuSnapshot  String   @map("product_sku_snapshot") @db.VarChar(64)
  productNameSnapshot String   @map("product_name_snapshot") @db.Text
  receivedQuantity    Decimal  @map("received_quantity") @db.Decimal(18, 4)
  actualUnitCost      Decimal  @map("actual_unit_cost") @db.Decimal(19, 4)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  receipt              PurchaseReceipt       @relation(fields: [receiptId, organizationId, purchaseOrderId, branchId], references: [id, organizationId, purchaseOrderId, branchId], onDelete: Restrict, onUpdate: Restrict)
  purchaseOrderItem    PurchaseOrderItem     @relation(fields: [purchaseOrderItemId, organizationId, purchaseOrderId, productId], references: [id, organizationId, purchaseOrderId, productId], onDelete: Restrict, onUpdate: Restrict)
  product              Product               @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  inventoryTransaction InventoryTransaction?

  @@unique([receiptId, productId], map: "purchase_receipt_items_receipt_id_product_id_key")
  @@unique([purchaseOrderItemId, organizationId, purchaseOrderId, productId], map: "purchase_receipt_items_purchase_order_item_scope_key")
  @@unique([id, organizationId, branchId, productId], map: "purchase_receipt_items_inventory_transaction_scope_key")
  @@map("purchase_receipt_items")
}

model Sale {
  id                       String                   @id @default(uuid()) @db.Uuid
  organizationId           String                   @map("organization_id") @db.Uuid
  branchId                 String                   @map("branch_id") @db.Uuid
  actorUserId              String                   @map("actor_user_id") @db.Uuid
  actorMembershipId        String                   @map("actor_membership_id") @db.Uuid
  reference                String                   @db.VarChar(41)
