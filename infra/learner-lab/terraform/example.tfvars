# Copy to demo.tfvars (ignored by Git) and adjust. No secrets here: every secret
# value is generated by operator/put-secrets.sh straight into Secrets Manager.
# Image digests and app_desired_count are passed by operator/deploy.sh.
region        = "us-east-1"
demo_hostname = "stockwise.hcn920.com"
email_from    = "StockWise <no-reply@hcn920.com>" # a sender on a Resend-verified domain
demo_end_time = "2026-11-21T16:59:00Z"            # end of the demo window (UTC, must be in the future at apply time; 16:59Z = 23:59 Asia/Bangkok)

# Optional:
# alarm_email       = "owner@example.com"
# enable_cloudfront = true   # only after CloudFront access is verified
