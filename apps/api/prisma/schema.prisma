model InventoryTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  branchId              String   @map("branch_id") @db.Uuid
  productId             String   @map("product_id") @db.Uuid
  delta                 Decimal  @db.Decimal(18, 4)
  source                String   @db.VarChar(50)
  adjustmentReason      String?  @map("adjustment_reason") @db.VarChar(50)
  note                  String?  @db.Text
  actorUserId           String   @map("actor_user_id") @db.Uuid
  actorMembershipId     String   @map("actor_membership_id") @db.Uuid
  idempotencyKeyHash    String?  @map("idempotency_key_hash") @db.VarChar(64)
  canonicalRequestHash  String?  @map("canonical_request_hash") @db.VarChar(64)
  purchaseReceiptItemId String?  @map("purchase_receipt_item_id") @db.Uuid
  saleItemId            String?  @map("sale_item_id") @db.Uuid
  saleRefundItemId      String?  @map("sale_refund_item_id") @db.Uuid
  occurredAt            DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch              Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  product             Product                @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  actorUser           User                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorMembership     OrganizationMembership @relation("InventoryTransactionActorMembership", fields: [organizationId, actorMembershipId, actorUserId], references: [organizationId, id, userId], onDelete: Restrict, onUpdate: Restrict, map: "inventory_transactions_actor_membership_fkey")
  purchaseReceiptItem PurchaseReceiptItem?   @relation(fields: [purchaseReceiptItemId, organizationId, branchId, productId], references: [id, organizationId, branchId, productId], onDelete: Restrict, onUpdate: Restrict, map: "inventory_transactions_purchase_receipt_item_fkey")
  saleItem            SaleItem?              @relation(fields: [saleItemId, organizationId, branchId, productId], references: [id, organizationId, branchId, productId], onDelete: Restrict, onUpdate: Restrict, map: "inventory_transactions_sale_item_fkey")
  saleRefundItem      SaleRefundItem?        @relation(fields: [saleRefundItemId, organizationId, branchId, productId], references: [id, organizationId, branchId, productId], onDelete: Restrict, onUpdate: Restrict, map: "inventory_transactions_sale_refund_item_fkey")

  @@unique([organizationId, idempotencyKeyHash], map: "inventory_transactions_organization_id_idempotency_key_hash_key")
  @@unique([purchaseReceiptItemId, organizationId, branchId, productId], map: "inventory_transactions_purchase_receipt_item_scope_key")
  @@unique([saleItemId, organizationId, branchId, productId], map: "inventory_transactions_sale_item_scope_key")
  @@unique([saleRefundItemId, organizationId, branchId, productId], map: "inventory_transactions_sale_refund_item_scope_key")
  @@index([branchId, productId, occurredAt, id], map: "inventory_transactions_branch_product_time_idx")
  @@map("inventory_transactions")
}

model FirstOrganizationOnboarding {
