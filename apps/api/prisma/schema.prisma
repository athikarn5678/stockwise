model Invitation {
  id                    String                      @id @default(uuid()) @db.Uuid
  organizationId        String                      @map("organization_id") @db.Uuid
  invitedEmail          String                      @map("invited_email") @db.VarChar(320)
  intendedRole          OrganizationRole            @map("intended_role")
  tokenHash             String                      @unique(map: "invitations_token_hash_key") @map("token_hash") @db.VarChar(128)
  issuedAt              DateTime                    @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt             DateTime                    @map("expires_at") @db.Timestamptz(3)
  consumedAt            DateTime?                   @map("consumed_at") @db.Timestamptz(3)
  revokedAt             DateTime?                   @map("revoked_at") @db.Timestamptz(3)
  replacedAt            DateTime?                   @map("replaced_at") @db.Timestamptz(3)
  acceptedByUserId      String?                     @map("accepted_by_user_id") @db.Uuid
  issuedByMembershipId  String                      @map("issued_by_membership_id") @db.Uuid
  revokedByMembershipId String?                     @map("revoked_by_membership_id") @db.Uuid
  revocationReason      InvitationRevocationReason? @map("revocation_reason")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy          User?                   @relation(fields: [acceptedByUserId, invitedEmail], references: [id, email], onDelete: Restrict, onUpdate: Restrict)
  branchScopes        InvitationBranchScope[]
  issuedByMembership  OrganizationMembership  @relation("InvitationIssuer", fields: [organizationId, issuedByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  revokedByMembership OrganizationMembership? @relation("InvitationRevoker", fields: [organizationId, revokedByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  sourcedMembership   OrganizationMembership? @relation("MembershipSourceInvitation")

  @@unique([id, organizationId], map: "invitations_id_organization_id_key")
  @@index([organizationId, invitedEmail], map: "invitations_organization_id_invited_email_idx")
  @@index([acceptedByUserId], map: "invitations_accepted_by_user_id_idx")
  @@map("invitations")
}

model InvitationBranchScope {
  organizationId String @map("organization_id") @db.Uuid
  invitationId   String @map("invitation_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid

  invitation Invitation @relation(fields: [invitationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  branch     Branch     @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, invitationId, branchId], map: "invitation_branch_scopes_pkey")
  @@index([invitationId, organizationId], map: "invitation_branch_scopes_invitation_organization_idx")
  @@index([branchId, organizationId], map: "invitation_branch_scopes_branch_organization_idx")
  @@map("invitation_branch_scopes")
}

model MembershipAccessEvent {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  targetMembershipId String                    @map("target_membership_id") @db.Uuid
  actorUserId        String                    @map("actor_user_id") @db.Uuid
  actorMembershipId  String?                   @map("actor_membership_id") @db.Uuid
  eventType          MembershipAccessEventType @map("event_type")
  beforeRole         OrganizationRole?         @map("before_role")
  beforeStatus       MembershipStatus?         @map("before_status")
  afterRole          OrganizationRole          @map("after_role")
  afterStatus        MembershipStatus          @map("after_status")
  occurredAt         DateTime                  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  targetMembership OrganizationMembership             @relation("MembershipAccessEventTarget", fields: [organizationId, targetMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actorUser        User                               @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorMembership  OrganizationMembership?            @relation("MembershipAccessEventActor", fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  branchScopes     MembershipAccessEventBranchScope[]

  @@unique([id, organizationId], map: "membership_access_events_id_organization_id_key")
  @@index([organizationId, targetMembershipId, occurredAt], map: "membership_access_events_target_time_idx")
  @@index([actorUserId, occurredAt], map: "membership_access_events_actor_time_idx")
  @@map("membership_access_events")
}

model MembershipAccessEventBranchScope {
  organizationId String @map("organization_id") @db.Uuid
  eventId        String @map("event_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid

  event  MembershipAccessEvent @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  branch Branch                @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, eventId, branchId], map: "membership_access_event_branch_scopes_pkey")
  @@index([branchId, organizationId], map: "membership_access_event_branch_scopes_branch_organization_idx")
  @@map("membership_access_event_branch_scopes")
}

